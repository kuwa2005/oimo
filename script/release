#!/usr/bin/env bash
set -euo pipefail

REPO="${GH_REPO:-kuwa2005/oimo}"
BUMP_TYPE="patch"
VERSION=""
WATCH=1

usage() {
  cat <<'EOF'
Usage: script/release [major|minor|patch] [--version X.Y.Z] [--no-watch] [--help]

Cut a release: preflight -> bump & commit -> push branch + tag vX.Y.Z ->
GitHub Actions (release.yml) builds and publishes the release automatically.
Full runbook: docs/RELEASING.md

Options:
  major|minor|patch   Bump type (default: patch)
  --version X.Y.Z     Override the release version (takes precedence over bump)
  --no-watch          Push the tag and exit without watching the workflow
  --help              Show this help
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    major|minor|patch) BUMP_TYPE="$1" ;;
    --version) VERSION="${2:-}"; shift ;;
    --no-watch) WATCH=0 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

# --- Preflight ---
if ! command -v gh >/dev/null 2>&1; then
  echo "Error: gh CLI is not installed (https://cli.github.com/)" >&2
  exit 1
fi
if ! gh auth status >/dev/null 2>&1; then
  echo "Error: not authenticated with gh. Run: gh auth login" >&2
  exit 1
fi
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  echo "Warning: working tree has uncommitted changes; the release bump commit includes package.json files only."
  git status --short 2>/dev/null | head -20
fi

echo "--- Secrets ($REPO) ---"
SECRETS=$(gh secret list --repo "$REPO" --json name -q '.[].name' 2>/dev/null || true)
for s in MIMO_FDS_AK MIMO_FDS_SK; do
  if printf '%s\n' "$SECRETS" | grep -qx "$s"; then
    echo "  [ok]   $s"
  else
    echo "  [skip] $s is not set -> FDS mirror upload will be skipped"
  fi
done
echo "  (npm publish disabled for this fork; GitHub Releases only)"

# --- Bump & commit ---
echo "--- Bump ---"
VERSION=$(bun script/bump.ts "${VERSION:-$BUMP_TYPE}" | tail -1)
echo "Release version: v$VERSION"

# --- Push branch + tag ---
BRANCH=$(git branch --show-current 2>/dev/null || true)
if [ -n "$BRANCH" ]; then
  echo "--- Push branch ---"
  git push origin "HEAD:$BRANCH"
fi
echo "--- Push tag ---"
# Stale local tags (same name, wrong SHA) make `git tag` fail after the bump
# commit is already pushed. Drop a local-only mismatch; refuse if origin has it.
if git rev-parse "refs/tags/v$VERSION" >/dev/null 2>&1; then
  LOCAL_SHA=$(git rev-parse "refs/tags/v$VERSION^{}")
  HEAD_SHA=$(git rev-parse HEAD)
  if [ "$LOCAL_SHA" = "$HEAD_SHA" ]; then
    echo "Local tag v$VERSION already points at HEAD"
  else
    echo "Removing stale local tag v$VERSION ($LOCAL_SHA != HEAD $HEAD_SHA)"
    git tag -d "v$VERSION"
  fi
fi
if git ls-remote --tags origin "refs/tags/v$VERSION" | grep -q .; then
  echo "Error: origin already has tag v$VERSION — bump again or delete the remote tag first." >&2
  exit 1
fi
if ! git rev-parse "refs/tags/v$VERSION" >/dev/null 2>&1; then
  git tag "v$VERSION"
fi
git push origin "v$VERSION"

# --- Locate the workflow run triggered by the tag push ---
echo "--- Workflow ---"
RUN_ID=""
for _ in $(seq 1 30); do
  RUN_ID=$(gh run list --workflow release.yml --repo "$REPO" --limit 10 --json databaseId,headBranch -q ".[] | select(.headBranch == \"v$VERSION\") | .databaseId" 2>/dev/null | head -1 || true)
  if [ -n "$RUN_ID" ]; then
    break
  fi
  sleep 2
done
if [ -z "$RUN_ID" ]; then
  echo "Run not found yet; check: https://github.com/$REPO/actions/workflows/release.yml" >&2
  exit 1
fi
echo "Run: https://github.com/$REPO/actions/runs/$RUN_ID"

# --- Watch ---
if [ "$WATCH" -eq 1 ]; then
  echo "Watching run (Ctrl-C stops watching; the workflow keeps running)..."
  if ! gh run watch "$RUN_ID" --repo "$REPO" --exit-status; then
    echo "Workflow failed:" >&2
    gh run view "$RUN_ID" --repo "$REPO" --log-failed >&2 || true
    exit 1
  fi
  echo "--- Jobs ---"
  gh run view "$RUN_ID" --repo "$REPO"
  echo "Release URL: https://github.com/$REPO/releases/tag/v$VERSION"
fi

echo
echo "Done. 手順の詳細は docs/RELEASING.md を参照。"
